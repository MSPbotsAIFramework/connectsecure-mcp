# Optional overrides — connectsecure-mcp has no required env vars.
# Authentication is per-request via three request headers, since ConnectSecure
# is multi-tenant (every tenant is provisioned on its own pod hostname) and
# this server never persists credentials:
#   X-ConnectSecure-Access-Token — JWT access token obtained from
#     POST {base_url}/w/authorize with header
#     Client-Auth-Token: base64(tenant_name + client_id : client_secret)
#   X-ConnectSecure-User-Id — the user_id returned alongside access_token by
#     the same /w/authorize call
#   X-ConnectSecure-Base-Url — this tenant's ConnectSecure pod hostname,
#     e.g. https://pod1.connectsecure.com
# This server forwards the token as "Authorization: Bearer <token>" and the
# user id as "X-USER-ID" on every upstream call.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
